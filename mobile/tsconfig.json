    "strict": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["react", "node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*", "index.js", "../shared/**/*"]
}
